// The stand-in rules of the basic content set that the simulation reads from a job: the data of the builder, the digger,
// and the pig farmer. Every value is the project's own invention, never taken from the original game (INV-0001,
// ADR 0018); the comment on each line states why.
{
  // The jobs the set has, by stable name. The rules of every job hang on its type in the engine, so the set lists each of them:
  // a name that is no job's, and a job left out, refuse the file. No job of the set has an original code.
  "names": [
    "baker", // Works in the bakery and turns flour into bread.
    "builder", // Builds a site once its materials are there.
    "butcher", // Works in the butcher's shop and turns pigs into meat.
    "carrier", // Carries goods along a road.
    "castle-settler", // The first settler, who stands by while the castle is built.
    "digger", // Levels the ground of a large site.
    "farmer", // Sows and harvests the farm's fields.
    "fisher", // Casts at a lake and brings fish to the flag.
    "forester", // Plants saplings around the forester's hut.
    "jobless", // A settler without a job, who takes a tool to become a worker.
    "knight-level-0", // The knight of the first level, who waits in the castle.
    "knight-level-1", // The knight of the second level.
    "knight-level-2", // The knight of the third level.
    "knight-level-3", // The knight of the fourth level.
    "knight-level-4", // The knight of the last level.
    "miller", // Works in the mill and turns grain into flour.
    "pig-farmer", // Tends the pigs of the pig farm.
    "sawmiller", // Works in the sawmill and turns logs into planks.
    "stonecutter", // Cuts stones from the stone heaps.
    "woodcutter", // Cuts trees and brings logs to the flag.
  ],
  "jobs": {
    "builder": {
      "tool": "hammer", // A building site asks for a builder, and a jobless settler takes a hammer to become one.
    },
    "digger": {
      "tool": "shovel", // A large site asks for a digger to level its ground, and a jobless settler takes a shovel.
    },
    "pig-farmer": {
      // The rank the pig farm's grain request starts from, 1 to 255; it falls as the farm fills.
      "rankBase": 180, // Below the mill's grain request, so the mill is served first.
      // The chance in percent, 0 to 100, that another pig grows in a pause of the work, for a farm that holds 0 to 7
      // pigs: exactly eight values.
      "growth": [
        90, // An empty farm: a pig nearly always grows.
        80, // One pig held.
        70, // Two pigs held.
        60, // Three pigs held.
        50, // Four pigs held.
        40, // Five pigs held.
        30, // Six pigs held.
        20, // Seven pigs held: the pens are crowded, so growth slows.
      ],
    },
  },
}
