<Project Sdk="MSTest.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenSettlers.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Godot-free engine code is compiled in directly, so the tests run without Godot. A folder left
         out of this list is silently untested. -->
    <Compile Include="../../src/Launch/**/*.cs" />
    <Compile Include="../../src/Formats/**/*.cs" />
    <Compile Include="../../src/Assets/**/*.cs" />
    <Compile Include="../../src/Simulation/**/*.cs" />
    <Compile Include="../../src/MapView/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="map-digests.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="windows-run.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="build-sites.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="castle-placements.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="castle-sites.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="flag-verdicts.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="flag-placements.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="road-builds.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="road-strips.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="worker-walks.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="carrier-walks.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
