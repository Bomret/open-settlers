# A woodcutter's hut that stands with no flag puts its flag down on the node south-east of it; a road from the castle's flag
# to that flag then brings the woodcutter's log home.
# Run it on the layout: sh tools/play-run.sh hut-flag --layout layouts/hut-flag.jsonc --fps 10
# The castle stands at 10,10, so its flag is at 11,11. The woodcutter's hut at 13,10 puts its flag at 14,11.
wait 0.3
expect-at 13 10 building
expect-at 14 11 flag
shot placed 13 10 1 2

button Road
click-tile 11 11
click-tile 12 11
click-tile 13 11
click-tile 14 11
button Road
wait 0.3
expect-at 13 11 road
shot road

# The castle starts with 4 logs; a fifth is the woodcutter's.
fast-forward until logs >= 5 max 20000
wait 0.3
expect logs >= 5
shot log
