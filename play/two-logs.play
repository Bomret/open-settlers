# A woodcutter's flag whose road waits for a carrier until the castle's settler supply makes one; its logs then go to the
# castle one after the other.
# Run it on the layout: sh tools/play-run.sh two-logs --layout layouts/two-logs.jsonc --fps 10
# The castle starts with 5 settlers that can carry (2 carriers and 3 of job 21). Five short roads from the castle's flag
# take them all, so the road from the woodcutter's flag to the castle gets no carrier and the logs wait on that flag.
# The layout's seed gives the settler rate 16, so the castle gains a settler without a job every 275 ticks
# (docs/rules/new-settlers.md). The first one takes the castle road, and the logs go one by one.
# The castle stands at 10,10, so its flag is at 11,11. The woodcutter's hut at 8,12 has its flag at 9,13, and his road leads
# to the flag at 9,11.
wait 0.3
fast-forward until count waits-at-flag = 5 max 2000
wait 0.3
expect-count jobless = 0
dump decoys
shot decoys

expect logs = 0
expect-at 8 12 building
expect-at 9 13 flag
dump woodcutter
shot woodcutter

# The castle's first new settler takes the woodcutter's road: a sixth carrier waits at a flag.
fast-forward until count waits-at-flag = 6 max 2000
wait 0.3
expect ticks >= 275
expect logs = 0
expect-count jobless = 0
dump carrier
shot carrier

# The second new settler is a knight (the castle holds swords and shields); the third, two periods after the first, waits in
# the castle without a job.
fast-forward until count jobless = 1 max 400
wait 0.3
expect-count jobless = 1
dump jobless
shot jobless

# The first log reaches the castle.
fast-forward until logs = 1 max 4000
wait 0.3
expect logs = 1
dump first
shot first

# The second log reaches the castle.
fast-forward until logs = 2 max 4000
wait 0.3
expect logs = 2
dump second
shot second
