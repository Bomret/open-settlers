# A woodcutter's building site on a flag that has a road to the castle no carrier works yet.
# Run it on the game view with seed 1234567812345678 and size 1:
#   --game-view --seed 1234567812345678 --size 1 --play play/two-logs.play
# The castle starts with 5 settlers that can carry (2 carriers and 3 of job 21). Five short roads from the castle's flag
# take them all, so the road from the site's flag to the castle gets no carrier. A site has no woodcutter, so no log
# waits on its flag (the logs of the woodcutter, and the carrier that takes them, come back with the construction, M4).
# On that map the castle stands at 21,4, so its flag is at 22,5. The woodcutter goes to 26,4, its flag to 27,5.
expect seed = 1234567812345678
expect size = 1
wait 0.3
click-tile 21 4
wait 0.3

button Flag
click-tile 20 3
click-tile 22 3
click-tile 20 5
click-tile 20 6
click-tile 20 7
button Flag
wait 0.3

# The five roads that take the carriers.
button Road
click-tile 20 3
click-tile 21 3
click-tile 22 4
click-tile 22 5
button Road
button Road
click-tile 22 3
click-tile 23 4
click-tile 23 5
click-tile 22 5
button Road
button Road
click-tile 20 5
click-tile 21 5
click-tile 22 5
button Road
button Road
click-tile 20 6
click-tile 21 6
click-tile 22 6
click-tile 22 5
button Road
button Road
click-tile 20 7
click-tile 19 6
click-tile 19 5
click-tile 20 5
button Road
fast-forward until count waits-at-flag = 5 max 2000
wait 0.3
dump decoys
shot decoys

# The castle road, which finds no carrier, and the woodcutter's site. A road starts only on a flag that stands, so the
# flag gets a wait before the road is drawn from it.
button Flag
click-tile 27 5
button Flag
wait 0.3
button Road
click-tile 27 5
click-tile 27 6
click-tile 26 6
click-tile 25 6
click-tile 24 6
click-tile 23 6
click-tile 22 5
button Road
wait 0.3
shot castle-road
button Woodcutter
click-tile 26 4
button Woodcutter
wait 0.3
expect logs = 4
expect-at 26 4 building
dump woodcutter
shot woodcutter

# No carrier works the castle road, and no log waits on the site's flag.
fast-forward until ticks >= 2000 max 2000
wait 0.3
expect logs = 4
expect flag-goods:27,5 = 0
dump after
shot after
