# A woodcutter's flag that holds two logs sends both to the castle, one after the other.
# Run it on the layout: sh tools/play-run.sh two-logs --layout layouts/two-logs.jsonc --fps 10
# The castle starts with 5 settlers that can carry (2 carriers and 3 of job 21). Five short roads from the castle's flag
# take them all, so the road from the woodcutter's flag to the castle gets no carrier and the logs wait on that flag.
# Taking one of the five roads down sends its carrier home; the castle road then gets it, and the logs go one by one.
# The castle stands at 10,10, so its flag is at 11,11. The woodcutter's hut at 8,12 has its flag at 9,13, and his road leads
# to the flag at 9,11.
wait 0.3
fast-forward until count waits-at-flag = 5 max 2000
wait 0.3
dump decoys
shot decoys

expect logs = 0
expect-at 8 12 building
expect-at 9 13 flag
dump woodcutter
shot woodcutter

# Two logs wait on the woodcutter's flag; none has reached the castle.
fast-forward until flag-goods:9,13 = 2 max 20000
wait 0.3
expect logs = 0
expect flag-goods:9,13 = 2
dump two-logs
shot two-logs

# Taking the decoy road that leaves the castle's flag north down frees its carrier for the woodcutter's road.
button Remove
click-tile 11 10
button Remove
wait 0.3
shot removed

# The carrier has lifted the first log; the second still waits on the flag.
fast-forward until flag-goods:9,13 = 1 max 2000
wait 0.3
expect logs = 0
expect flag-goods:9,13 = 1
dump one-left
shot one-left

# The first log reaches the castle. The second still waits (a third the woodcutter cut may lie beside it).
fast-forward until logs = 1 max 2000
wait 0.3
expect logs = 1
expect flag-goods:9,13 >= 1
dump first
shot first

# The second log reaches the castle.
fast-forward until logs = 2 max 2000
wait 0.3
expect logs = 2
dump second
shot second
