# A woodcutter's hut whose flag lands on a road stands, and its flag splits the road into two roads that meet at it; a carrier
# works each half and the woodcutter walks out to his trees.
# Run it on the layout: sh tools/play-run.sh hut-on-road --layout layouts/hut-on-road.jsonc --fps 10
# The castle stands at 10,10, so its flag is at 11,11. A road of seven steps joins it to a flag at 18,11. The woodcutter's hut
# at 13,10 has its flag on the road node 14,11.
wait 0.3
expect-at 13 10 building
expect-at 14 11 flag
expect-count flag = 3
name flag 14 11 flag
expect-event flag place-flag cause layout
expect-event flag split-roads cause layout
shot split 12 11 5 4
list split

# The woodcutter fells a tree; by then each half of the road holds a carrier.
fast-forward woodcutter state 0x11 max 40000
wait 0.3
expect-count carrier = 2
shot two-carriers 12 11 5 4
list two-carriers
dump after
