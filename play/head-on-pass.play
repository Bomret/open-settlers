# The carrier of a road that is taken down walks home west along the first road (docs/rules/settlers.md, "Passing"). The
# meeting with a woodcutter who walks out east along the same road needs a woodcutter that a layout's finished-building
# entry cannot set up at that moment: a hut put down in the run is a building site now, which has no worker (the woodcutter
# of a finished hut comes back with the construction, M4). The golden scenario head-on-pass-layout (GoldenTests) keeps the
# meeting.
# Run it on the layout: sh tools/play-run.sh head-on-pass --layout layouts/head-on-pass.jsonc --fps 10
wait 32
name cr 16 11 carrier
button Remove
click-tile 15 11
button Remove
wait 1
shot start
# The carrier has no woodcutter to meet: it walks home to the castle.
fast-forward until ticks >= 1000 max 3000
wait 0.3
expect-count building = 1
events cr carrier
shot walks-home 13 11 2 2
