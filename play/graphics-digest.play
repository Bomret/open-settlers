# One game, driven by clicks only, whose dump gives the game's digest: INV-0009 says the digest is the same under every
# graphics source. Run it once under each and compare the dumps:
#   sh tools/play-run.sh graphics-digest --game-view --seed 1234567812345678 --size 1 --fps 10 --graphics history-edition
#   sh tools/play-run.sh graphics-digest --game-view --seed 1234567812345678 --size 1 --fps 10 --graphics open-settlers
# On that map the castle stands at 21,4, so its flag is at 22,5. The woodcutter goes to 26,4, its flag to 27,5.
wait 0.3
click-tile 21 4
wait 0.3

button Woodcutter
click-tile 26 4
button Woodcutter
wait 0.3

button Road
click-tile 22 5
click-tile 23 5
click-tile 24 5
click-tile 25 5
click-tile 26 5
click-tile 27 5
button Road
wait 0.3
dump built

wait 30
dump end
