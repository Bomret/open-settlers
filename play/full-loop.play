# The whole construction loop from a fresh game: a person places a sawmill site and a woodcutter's site, a digger levels the sawmill's
# ground, the castle's planks and stones reach both sites over the roads and the builders build them, the woodcutter's logs reach the
# sawmill, and the planks it saws build a third site, a stonecutter's, that the castle could not pay for.
# Run it on the game view with seed 1234567812345634 and size 1, under either graphics source:
#   sh tools/play-run.sh full-loop --game-view --seed 1234567812345634 --size 1 --fps 10
#   sh tools/play-run.sh full-loop --game-view --seed 1234567812345634 --size 1 --fps 10 --graphics open-settlers
# On that map the castle stands at 24,3, so its flag is at 25,4, and it holds 5 planks and 2 stones, as many as the sawmill (3 planks, 2
# stones) and the woodcutter's hut (2 planks) need. The sawmill's site at 25,1 has its flag at 26,2, the woodcutter's at 26,4 its flag at 27,5.
expect seed = 1234567812345634
expect size = 1
wait 0.3
click-tile 24 3
wait 0.3
expect planks = 5
expect stones = 2
dump castle
shot castle 24 3 3 2

# The sawmill's site, a large building on a site for one, and the woodcutter's: each brings its flag south-east of it.
button Sawmill
click-tile 25 1
button Sawmill
button Woodcutter
click-tile 26 4
button Woodcutter
wait 0.3
expect-at 25 1 sawmill
expect-at 26 4 woodcutter-hut
expect-at 26 2 flag
expect-at 27 5 flag

# The roads to the castle's flag at 25,4: three steps north, east, and north to the sawmill's flag, and two steps south-east and east to
# the woodcutter's.
button Road
click-tile 25 4
click-tile 25 3
click-tile 26 3
click-tile 26 2
button Road
button Road
click-tile 25 4
click-tile 26 5
click-tile 27 5
button Road
wait 0.3
expect-count road = 6
shot sites 25 3 4 2
list sites

# The castle hands its 5 planks and 2 stones out to the two sites' flags, and its carriers take them over the roads.
fast-forward until planks = 0 max 20000
wait 0.3
expect planks = 0
expect stones = 0
dump handed-out
shot handed-out 25 3 4 2

# The castle holds no plank now. A third site, a stonecutter's at 23,4 with its flag at 24,5, can be paid for only by the planks the sawmill
# saws from the woodcutter's logs.
button Stonecutter
click-tile 23 4
button Stonecutter
wait 0.3
expect-at 24 5 flag
button Road
wait 0.3
click-tile 25 4
wait 0.3
click-tile 25 5
wait 0.3
click-tile 24 5
wait 0.3
button Road
wait 0.3
expect-at 23 4 stonecutter-hut
expect-count road = 8
expect planks = 0

# The sawmill is built, and its sawmiller walks in and waits for a log.
fast-forward until count saws >= 1 max 60000
wait 0.3
name mill 25 1 sawmill
expect mill.constructing = false
dump sawmill-built
shot sawmill-built 25 1 3 2

# The stonecutter's site is built from the planks of the sawmill: its worker walks in and looks for a heap.
fast-forward until count looks-for-heap >= 1 max 300000
wait 0.3
name hut 23 4 stonecutter-hut
expect hut.constructing = false
name woodcutter-hut 26 4 woodcutter-hut
expect woodcutter-hut.constructing = false
dump full-loop
shot full-loop 25 3 5 2
list full-loop
