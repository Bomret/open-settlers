# A castle that names its settlers: two carriers and one settler without a job (layouts/castle-contents.jsonc). Two sawmills ask for
# a sawmiller as the game runs; the castle holds none, so the first request makes the settler without a job the sawmiller with a
# saw from the castle's stock, and the second finds no settler.
# Run it on the layout with the install and with the basic content set:
#   sh tools/play-run.sh castle-contents --layout layouts/castle-contents.jsonc --fps 10
#   sh tools/play-run.sh castle-contents --layout layouts/castle-contents.jsonc --content-set basic --fps 10
# The layout's seed gives the settler rate 16, so the castle's settler supply makes its first settler without a job at tick 275
# (docs/rules/new-settlers.md); the script checks the two requests before then.
# The castle stands at 10,10 with its flag at 11,11; the sawmills stand at 15,10 and 6,10.
wait 0.3
expect-count jobless = 1
expect-count waits-at-flag = 2
expect-at 15 10 building
expect-at 6 10 building
shot start

fast-forward until count sawmiller = 1 max 270
wait 0.3
expect-count jobless = 0
list taken
shot taken

# The second sawmill finds no settler: no second sawmiller, and the castle has no settler without a job left.
fast-forward until ticks >= 250 max 270
wait 0.3
expect-count sawmiller = 1
expect-count jobless = 0
name east 15 10 building
name west 6 10 building
expect east.worker > 0
expect west.worker = 0
list none
shot none
