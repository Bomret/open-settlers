root = true

# docs/agents/CODING.md, "What the build enforces": every rule below fails the build (EnforceCodeStyleInBuild in
# Directory.Build.props, warnings as errors). Each rule's severity is set by its own dotnet_diagnostic line, because the
# command-line build ignores the `option = value:severity` suffix. No formatting rule: CSharpier owns formatting.
[*.cs]
# "Access modifiers": omit a modifier that is the default where it stands.
dotnet_style_require_accessibility_modifiers = omit_if_default
dotnet_diagnostic.IDE0040.severity = warning

# "var": var wherever it gives the same type.
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
dotnet_diagnostic.IDE0007.severity = warning

# A private field that is assigned only in its declaration or constructor is readonly.
dotnet_style_readonly_field = true
dotnet_diagnostic.IDE0044.severity = warning
