<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- The tests read the simulation's internal members, such as Map.Index. -->
    <InternalsVisibleTo Include="OpenSettlers.Tests" />
    <InternalsVisibleTo Include="OpenSettlers.Adapters.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="OpenSettlers.Domain" />
    <Using Include="OpenSettlers.Import" />
    <Using Include="OpenSettlers.Import.HistoryEdition" />
    <Using Include="OpenSettlers.Domain.RoadNetwork" Static="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- The generator runs in the compiler and is no run-time dependency (ADR 0016). -->
    <ProjectReference
      Include="../Generators/OpenSettlers.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Domain/OpenSettlers.Domain.csproj" />
    <ProjectReference Include="../Import/OpenSettlers.Import.csproj" />
    <ProjectReference Include="../Import.HistoryEdition/OpenSettlers.Import.HistoryEdition.csproj" />
    <ProjectReference Include="../Application/OpenSettlers.Application.csproj" />
  </ItemGroup>
</Project>
