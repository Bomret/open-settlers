  </ItemGroup>
  <ItemGroup>
    <Using Include="OpenSettlers.Domain" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Domain/OpenSettlers.Domain.csproj" />
    <ProjectReference Include="../Application/OpenSettlers.Application.csproj" />
  </ItemGroup>
</Project>
