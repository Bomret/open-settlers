<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <!-- The tests of the History Edition source (ADR 0019, INV-0012). The namespace stays the one every test had in the
         single test project, so a test keeps its name. -->
    <RootNamespace>OpenSettlers.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="OpenSettlers.Testing" />
    <Using Include="OpenSettlers.Domain.Testing" />
    <Using Include="OpenSettlers.Import.Testing" />
    <Using Include="OpenSettlers.Import.HistoryEdition.Testing" />
    <Using Include="OpenSettlers.Domain" />
    <Using Include="OpenSettlers.Import" />
    <Using Include="OpenSettlers.Import.HistoryEdition" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Import.HistoryEdition/OpenSettlers.Import.HistoryEdition.csproj" />
    <ProjectReference Include="../Testing/OpenSettlers.Testing.csproj" />
    <ProjectReference Include="../Domain.Testing/OpenSettlers.Domain.Testing.csproj" />
    <ProjectReference Include="../Import.Testing/OpenSettlers.Import.Testing.csproj" />
    <ProjectReference Include="../Import.HistoryEdition.Testing/OpenSettlers.Import.HistoryEdition.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="site-draws.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="settler-draws.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="road-strips.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
