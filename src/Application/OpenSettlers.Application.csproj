<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- The adapters, the game, and the tests read the internal members of the game's parts. -->
    <InternalsVisibleTo Include="OpenSettlers.Adapters" />
    <InternalsVisibleTo Include="OpenSettlers" />
    <InternalsVisibleTo Include="OpenSettlers.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="OpenSettlers.Domain" />
    <Using Include="OpenSettlers.Domain.RoadNetwork" Static="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- The generator runs in the compiler and is no run-time dependency (ADR 0016). -->
    <ProjectReference
      Include="../Generators/OpenSettlers.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Domain/OpenSettlers.Domain.csproj" />
  </ItemGroup>
</Project>
