<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>OpenSettlers</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- The libraries (Domain, Import, Import.HistoryEdition, Import.OpenSettlers, Application, Adapters, MapView, Launch, Assets) are their own projects, and so is the job generator, which runs in the compiler. Only src/Viewer holds Godot code. -->
    <Compile Remove="tools/**;**/*.Tests/**;**/*.Testing/**;src/Testing/**;OpenSettlers.Tests/**;src/Domain/**;src/Import/**;src/Import.HistoryEdition/**;src/Import.OpenSettlers/**;src/Application/**;src/Adapters/**;src/MapView/**;src/Launch/**;src/Assets/**;src/Generators/**" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="OpenSettlers.Import" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src/Domain/OpenSettlers.Domain.csproj" />
    <ProjectReference Include="src/Import/OpenSettlers.Import.csproj" />
    <ProjectReference Include="src/Import.HistoryEdition/OpenSettlers.Import.HistoryEdition.csproj" />
    <ProjectReference Include="src/Import.OpenSettlers/OpenSettlers.Import.OpenSettlers.csproj" />
    <ProjectReference Include="src/Application/OpenSettlers.Application.csproj" />
    <ProjectReference Include="src/Adapters/OpenSettlers.Adapters.csproj" />
    <ProjectReference Include="src/MapView/OpenSettlers.MapView.csproj" />
    <ProjectReference Include="src/Launch/OpenSettlers.Launch.csproj" />
    <ProjectReference Include="src/Assets/OpenSettlers.Assets.csproj" />
    <ProjectReference
      Include="src/Generators/OpenSettlers.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
