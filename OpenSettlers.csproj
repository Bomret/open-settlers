<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>OpenSettlers</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- The layer libraries (Domain, Application, Adapters) are their own projects. -->
    <Compile Remove="tools/**;tests/**;src/Domain/**;src/Application/**;src/Adapters/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src/Domain/OpenSettlers.Domain.csproj" />
    <ProjectReference Include="src/Application/OpenSettlers.Application.csproj" />
    <ProjectReference Include="src/Adapters/OpenSettlers.Adapters.csproj" />
  </ItemGroup>
</Project>
