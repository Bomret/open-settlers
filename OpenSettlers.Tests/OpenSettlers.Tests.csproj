<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <!-- The tests of the repository itself (ADR 0019, INV-0012): no library grants it internals, so the assembly name
         carries no library's name. -->
    <AssemblyName>OpenSettlers.Repository.Tests</AssemblyName>
    <RootNamespace>OpenSettlers.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="OpenSettlers.Testing" />
    <Using Include="OpenSettlers.Import.ContentSet" />
  </ItemGroup>
  <ItemGroup>
    <!-- InstallInitializerTests and PositionalRecordTests parse sources with it. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Testing/OpenSettlers.Testing.csproj" />
    <!-- RepositoryContentTests names the files the basic content set's readers own. -->
    <ProjectReference Include="../src/Import/OpenSettlers.Import.csproj" />
    <ProjectReference Include="../src/Import.OpenSettlers/OpenSettlers.Import.OpenSettlers.csproj" />
    <!-- JobCoverageTests compares the jobs with rules (the application's modules) with the jobs every source draws. -->
    <ProjectReference Include="../src/Application/OpenSettlers.Application.csproj" />
    <ProjectReference Include="../src/Import.Testing/OpenSettlers.Import.Testing.csproj" /> <!-- EmulatorLaunchTests hands the install's folder to the emulator harness. --> <ProjectReference Include="../src/Import.HistoryEdition.Testing/OpenSettlers.Import.HistoryEdition.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="map-digests.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="windows-run.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
